[Unit]
Description=Chickadee ephemeral GitHub Actions microVM runners
Wants=network-online.target
After=network-online.target chickadee-network.service
Requires=chickadee-network.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User=chickadee
Group=chickadee
SupplementaryGroups=kvm
ExecStartPre=/usr/local/lib/chickadee/preflight.sh
ExecStart=/usr/local/bin/chickadee -config /etc/chickadee/config.json
# Queue-only reloads preserve running jobs and warm VMs. The operator checks
# /var/lib/chickadee/reload.json for the applied config SHA and outcome.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStopSec=180
# Startup verifies large immutable images before admitting any VM.
TimeoutStartSec=300
UMask=0077
StateDirectory=chickadee
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# A masked parent proc prevents unprivileged bubblewrap from mounting its
# private PID-namespace proc. Host sysctl writes remain denied by the service
# UID and empty capability set; preflight verifies denial without writing.
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
DevicePolicy=closed
DeviceAllow=/dev/urandom r
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/net/tun rw
ReadOnlyPaths=/var/lib/chickadee-image
ReadWritePaths=/var/lib/chickadee
# Defaults for example config; installer generates a drop-in from configured limits.
MemoryMax=6G
MemorySwapMax=0
CPUQuota=400%
TasksMax=388
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
