[Unit]
Description=Chickadee approved-beta onboarding and access reconciliation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/chickadee/managed.env
ExecStart=/usr/bin/python3 /usr/local/lib/chickadee/reconcile-site.py --config /etc/chickadee/config.json --policy /etc/chickadee/managed-policy.json --site-host ${CHICKADEE_SITE_HOST} --ssh-key /etc/chickadee/site-ssh.pem --known-hosts /etc/chickadee/site-known-hosts
TimeoutStartSec=4200
RuntimeDirectory=chickadee-managed
RuntimeDirectoryMode=0700
StateDirectory=chickadee-managed
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/chickadee /var/lib/chickadee /run/chickadee-managed
